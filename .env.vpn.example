# Copy to .env.vpn and supply your VPN account's settings.
# Docker env-file syntax: unquoted KEY=value, with no shell expansions.
VPN_SERVICE_PROVIDER=surfshark
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=10.14.0.2/16
# The batch runner sets SERVER_COUNTRIES separately for each measurement.
# Allow your database network through Gluetun's firewall if needed, for example:
# FIREWALL_OUTBOUND_SUBNETS=192.168.0.0/16,172.17.0.0/16

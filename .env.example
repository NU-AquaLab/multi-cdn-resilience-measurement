# Docker launchers expect unquoted KEY=value lines without shell expansions.
# Copy to .env. Keep credentials and cookie files out of version control.
DB_NAME=measure_tiktok
DB_USER=measure_tiktok
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Required by fallback commands: the value of your TikTok sessionid cookie.
TIKTOK_SESSION_ID=
# collect-vod writes this file; collect-live and VOD fallback read it.
TIKTOK_COOKIE_FILE=tiktok_cookies.pkl
# collect-vod needs a visible browser for manual login.
HEADLESS=0

# Paths are relative to the .env directory, or the working directory by default.
OUTPUT_DIR=results
# LIVE_CATEGORIES_FILE=categories.json
# Firewall backend is detected automatically; override with linux or mac.
# MEASUREMENT_OS=linux
# Packet capture helper: use your measurement interface.
CAPTURE_INTERFACE=eth0
# Optional metadata label; leave blank when no VPN is used.
VPN_PROVIDER=
# Optional infrastructure database, used only by InfraDB.
# INFRA_DB_HOST=localhost
# Live fallback originally ran without database writes. Enable them explicitly.
LIVE_FALLBACK_WRITE_DB=0
# Optional browser binary override, e.g. /usr/bin/chromium in Docker.
# CHROME_BINARY=/usr/bin/chromium
